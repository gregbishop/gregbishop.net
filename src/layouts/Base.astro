---
import '../styles/global.css';
import { AUTHOR, SITE_NAME, TAGLINE, EMAIL } from '../lib/screens.mjs';

interface Props {
  title?: string;
  description?: string;
  current?: string;
}
const {
  title = `${AUTHOR} — ${TAGLINE}`,
  description = 'Notes on building AI tools and building a homestead.',
  current = '',
} = Astro.props;
const nav = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/posts/', label: 'Blog', key: 'posts' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/melampus/', label: 'Melampus', key: 'melampus' },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta name="theme-color" content="#171915" />
</head>
<body>
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label={`${AUTHOR} — Home`}>{AUTHOR}<span aria-hidden="true">.</span></a>
      <nav aria-label="Main navigation">
        {nav.map((item) => <a href={item.href} aria-current={current === item.key ? 'page' : undefined}>{item.label}</a>)}
      </nav>
    </div>
  </header>
  <main id="main" class="wrap" tabindex="-1"><slot /></main>
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <div><strong>{AUTHOR}</strong><p>{TAGLINE}</p></div>
      <nav aria-label="Contact and feeds">
        <a href={`mailto:${EMAIL}`}>Email</a>
        <a href="https://github.com/gregbishop">GitHub</a>
        <a href="/rss.xml">RSS feed</a>
      </nav>
    </div>
  </footer>
</body>
</html>

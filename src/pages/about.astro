---
import Base from '../layouts/Base.astro';
import { ABOUT, contactLines } from '../lib/screens.mjs';
import { toHtml } from '../lib/tty.mjs';
---
<Base current="about" title="about - gregbishop.net">
  <div class="screen">
    <p class="cmdline"><span class="prompt">$ </span>whoami --verbose</p>

    <article class="prose">
      {ABOUT.map((p) => <p>{p}</p>)}
    </article>

    <p class="cmdline"><span class="prompt">$ </span>cat contact</p>
    <pre class="tty"><code set:html={toHtml(contactLines())}></code></pre>

    <p class="cmdline"><span class="prompt">$ </span><span class="cursor" aria-hidden="true"></span></p>
  </div>
</Base>

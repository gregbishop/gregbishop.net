---
import Base from '../layouts/Base.astro';
import { ABOUT, EMAIL } from '../lib/screens.mjs';
---
<Base current="about" title="About — Greg Bishop">
  <article class="reading">
    <header class="page-heading"><span class="eyebrow">The person behind the notes</span><h1>About me</h1></header>
    <div class="prose">{ABOUT.map((paragraph) => <p>{paragraph}</p>)}</div>
    <section class="contact-card" aria-labelledby="contact-heading">
      <h2 id="contact-heading">Say hello</h2>
      <p>The garden is unlikely to answer, but I usually do.</p>
      <a class="button" href={`mailto:${EMAIL}`}>{EMAIL}</a>
    </section>
  </article>
</Base>

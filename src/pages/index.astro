---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { homeBlocks, publishedPosts } from '../lib/screens.mjs';
import { toHtml, escapeHtml } from '../lib/tty.mjs';

const posts = publishedPosts(await getCollection('posts'));

const html = homeBlocks(posts)
  .map((b) => `<span class="cmdline"><span class="prompt">$ </span><span class="typed">${escapeHtml(b.cmd)}</span></span>\n<span class="out">${toHtml(b.lines)}</span>`)
  .join('\n')
  + '\n<span class="cmdline final"><span class="prompt">$ </span><span class="typed" id="cli-line"></span><span class="cursor" aria-hidden="true"></span></span>';
---
<Base current="home">
  <div class="termwrap">
    <pre class="terminal" id="term"><code set:html={html}></code></pre>
    <label for="cli-in" class="sr-only">Type a command</label>
    <input id="cli-in" type="text" autocomplete="off" autocapitalize="none" autocorrect="off" spellcheck="false" enterkeyhint="go" aria-label="Type a command. Try help." />
  </div>

  <script>
    import { mount } from '../scripts/cli.js';
    const term = document.getElementById('term');
    if (term) mount(term);
  </script>
</Base>

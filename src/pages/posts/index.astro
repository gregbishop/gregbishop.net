---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { listingLines, publishedPosts } from '../../lib/screens.mjs';
import { toHtml } from '../../lib/tty.mjs';

const posts = publishedPosts(await getCollection('posts'));
---
<Base current="posts" title="blog - gregbishop.net" description="Posts about building AI tools and a homestead.">
  <div class="screen">
    <p class="cmdline"><span class="prompt">$ </span>ls -lt posts/</p>
    <div class="prose"><h1>Blog</h1></div>
    <pre class="tty"><code set:html={toHtml(listingLines(posts))}></code></pre>
  </div>
</Base>

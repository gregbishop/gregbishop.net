---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/post-list.astro';
import { getCollection } from 'astro:content';
import { publishedPosts } from '../../lib/screens.mjs';
export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('posts'));
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) } }));
}
const { tag, posts } = Astro.props;
---
<Base title={`${tag} — Greg Bishop`} description={`Posts about ${tag}.`}>
  <header class="page-heading">
    <a class="back-link" href="/posts/">← Back to the blog</a>
    <span class="eyebrow">Filed under</span>
    <h1>{tag}</h1>
  </header>
  <section class="blog-list" aria-label={`Posts about ${tag}`}><PostList posts={posts} /></section>
</Base>

---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { listingLines, publishedPosts } from '../../lib/screens.mjs';
import { toHtml } from '../../lib/tty.mjs';

export async function getStaticPaths() {
  const posts = publishedPosts(await getCollection('posts'));
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];

  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      posts: posts.filter((p) => p.data.tags.includes(tag)),
    },
  }));
}

const { tag, posts } = Astro.props;
---
<Base title={`#${tag} - gregbishop.net`}>
  <div class="screen">
    <p class="cmdline"><span class="prompt">$ </span>grep -rl <span class="arg">"#{tag}"</span> posts/</p>
    <pre class="tty"><code set:html={toHtml(listingLines(posts))}></code></pre>
    <p class="cmdline"><span class="prompt">$ </span><span class="cursor" aria-hidden="true"></span></p>
  </div>
</Base>

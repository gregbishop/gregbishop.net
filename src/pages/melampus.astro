---
import Base from '../layouts/Base.astro';
import { MELAMPUS, MELAMPUS_URL } from '../lib/screens.mjs';
---
<Base current="melampus" title="Melampus — Greg Bishop" description={`${MELAMPUS.tagline} The camera records the bird. Melampus attempts to work out which bird.`}>
  <article class="reading">
    <header class="page-heading">
      <span class="eyebrow">A project</span>
      <h1>Melampus</h1>
      <p>{MELAMPUS.tagline}</p>
      <a class="button" href={MELAMPUS_URL}>Melampus on GitHub <span aria-hidden="true">↗</span></a>
    </header>
    <div class="prose">
      {MELAMPUS.intro.map((paragraph) => <p>{paragraph}</p>)}
      {MELAMPUS.sections.map((section) => <section>
        <h2>{section.title}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </section>)}
    </div>
  </article>
</Base>

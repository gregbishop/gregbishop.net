---
interface Props {
  slug: string;
  title: string;
  date: Date;
  blurb?: string;
  tags?: string[];
}
const { slug, title, date, blurb, tags = [] } = Astro.props;
const iso = date.toISOString().slice(0, 10);
---
<div class="row">
  <div class="date"><time datetime={iso}>{iso}</time></div>
  <div class="title"><a href={`/posts/${slug}/`}>{title}</a></div>
  {blurb && <div class="blurb">{blurb}</div>}
  {tags.length > 0 && (
    <div class="tags">
      {tags.map((t) => <a href={`/tags/${t}/`}>#{t}</a>)}
    </div>
  )}
</div>

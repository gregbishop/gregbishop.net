    "eslint": "10.10.0",
    "figlet": "^1.11.4",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "playwright": "1.62.0",
    "wrangler": "4.134.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
